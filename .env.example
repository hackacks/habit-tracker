# Used for self-referential links, OAuth callbacks, and API endpoints.
HABIT_FLOW_APP_URL="MY_APP_URL"

# PostgreSQL Database
HABIT_FLOW_DATABASE_URL="postgresql://user:password@host:port/dbname"

# AWS Cognito (Backend)
HABIT_FLOW_COGNITO_REGION="us-east-1"
HABIT_FLOW_COGNITO_USER_POOL_ID="us-east-1_xxxxx"

# AWS Cognito (Frontend)
VITE_HABIT_FLOW_COGNITO_REGION="us-east-1"
VITE_HABIT_FLOW_COGNITO_USER_POOL_ID="us-east-1_xxxxx"
VITE_HABIT_FLOW_COGNITO_APP_CLIENT_ID="xxxxxxxx"
